# Required login gate. Enter real values in Railway Variables, never commit them.
APP_ALLOWED_EMAIL=presenter@example.com
APP_AUTH_PASSWORD=replace-with-a-long-random-password
APP_SESSION_SECRET=replace-with-at-least-32-random-bytes
# Comma-separated server-side allowlist. The login body cannot grant faculty.
APP_FACULTY_EMAILS=presenter@example.com
# Student accounts: signup requests approved in /faculty-review-console/ (and the optional
# comma-separated APP_ROSTER_EMAILS) log in with a password derived from this secret.
# Required — without it approvals succeed but those students can never log in.
APP_ROSTER_SECRET=replace-with-at-least-32-random-bytes
# APP_ROSTER_EMAILS=student1@example.ac.kr,student2@example.ac.kr
APP_COOKIE_SECURE=1
PACCINE_REQUIRE_FULL_DEMO=1

# One Anthropic key powers both Faculty question generation and Medical Copilot.
ANTHROPIC_API_KEY=replace-in-railway-dashboard
PACCINE_COPILOT_PROVIDER=anthropic
PACCINE_COPILOT_MODEL=claude-sonnet-4-6

# Runtime behavior. PACCINE_DATA_ROOT must stay /app/data_private (the API modules read a fixed path;
# the start script refuses to boot if this differs).
PACCINE_DATA_ROOT=/app/data_private
PACCINE_RUNTIME_SEED_ROOT=/app/runtime_seed

# Faculty-only "원문 보기" library links (optional; defaults shown). Profile "pnu" adds the
# Pusan National University off-campus chain (library login -> lproxy). Set "none" to drop it.
# PACCINE_LIBRARY_PROFILE=pnu
# PACCINE_ACCESSMEDICINE_BOOKID=3541
# Other institutions with an EZproxy-style prefix (takes precedence over the pnu profile):
# PACCINE_LIBRARY_PROXY_PREFIX=https://libproxy.example.ac.kr/login?url=
