{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paccine.internal/schemas/item_writing_rule_registry.schema.json",
  "title": "P:accine Item-Writing Rule Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "source_registry", "default_profile",
    "profiles", "conflict_resolutions", "retrieval_routing", "rules"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "minLength": 1},
    "source_registry": {"type": "string", "minLength": 1},
    "default_profile": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "object"}
    },
    "conflict_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "resolution"],
        "properties": {
          "conflict_id": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    },
    "retrieval_routing": {
      "type": "object",
      "required": ["generation_stages", "post_exam_stages", "always_include_rule_ids", "never_prompt_source_roles"],
      "properties": {
        "generation_stages": {"type": "array", "items": {"type": "string"}},
        "post_exam_stages": {"type": "array", "items": {"type": "string"}},
        "always_include_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "never_prompt_source_roles": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/rule"}
    }
  },
  "definitions": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "title", "statement_ko", "stage", "severity",
        "exam_profiles", "assessment_tasks", "tags", "source_refs", "runtime"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^IW-[A-Z]+-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "statement_ko": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "enum": ["hard", "conditional", "recommended", "post_exam"]},
        "exam_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "assessment_tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "tags": {"type": "array", "items": {"type": "string"}},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "locator", "support"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1},
              "support": {"type": "string", "minLength": 1}
            }
          }
        },
        "runtime": {
          "type": "object",
          "required": ["prompt", "validator", "fail_action"],
          "properties": {
            "prompt": {"type": "boolean"},
            "validator": {"type": "string", "minLength": 1},
            "fail_action": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
