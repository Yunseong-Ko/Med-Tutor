{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paccine.local/schemas/external_kg_crosswalk.schema.json",
  "title": "P:accine local-to-external knowledge graph crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "crosswalk_id",
    "generated_at",
    "source_snapshots",
    "review_policy",
    "mappings"
  ],
  "properties": {
    "schema_version": {"const": "external_kg_crosswalk.v1"},
    "crosswalk_id": {
      "type": "string",
      "pattern": "^external_kg_crosswalk:[a-z0-9][a-z0-9._-]*$"
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/snapshotRef"}
    },
    "review_policy": {"$ref": "#/$defs/failClosedReview"},
    "mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/mapping"}
    }
  },
  "$defs": {
    "curie": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*:[^\\s]+$"
    },
    "snapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "artifact_sha256"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "failClosedReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "needs_review",
        "medical_approval",
        "student_visible",
        "analytics_eligible",
        "promotion_status",
        "reviewer_id",
        "reviewed_at"
      ],
      "properties": {
        "status": {"const": "external_candidate"},
        "needs_review": {"const": true},
        "medical_approval": {"const": false},
        "student_visible": {"const": false},
        "analytics_eligible": {"const": false},
        "promotion_status": {"const": "not_promoted"},
        "reviewer_id": {"const": null},
        "reviewed_at": {"const": null}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_id", "source_record_sha256"],
      "properties": {
        "source_record_id": {"type": "string", "minLength": 1},
        "source_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "note": {"type": "string"}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_id",
        "local_concept_id",
        "external_curie",
        "external_label",
        "external_snapshot_id",
        "mapping_relation",
        "mapping_method",
        "confidence",
        "evidence",
        "review"
      ],
      "properties": {
        "mapping_id": {
          "type": "string",
          "pattern": "^ekg:x:[0-9a-f]{24}$"
        },
        "local_concept_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "external_curie": {"$ref": "#/$defs/curie"},
        "external_label": {"type": "string", "minLength": 1},
        "external_snapshot_id": {"type": "string", "minLength": 1},
        "mapping_relation": {
          "enum": [
            "exact_match",
            "close_match",
            "broad_match",
            "narrow_match",
            "related_match",
            "member_of_group"
          ]
        },
        "mapping_method": {
          "enum": [
            "identifier_exact",
            "source_xref",
            "curated",
            "lexical_candidate",
            "group_member_candidate"
          ]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRef"}
        },
        "review": {"$ref": "#/$defs/failClosedReview"}
      }
    }
  }
}
