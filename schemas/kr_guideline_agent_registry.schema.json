{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://paccine.internal/schemas/kr_guideline_agent_registry.schema.json",
  "title": "Korean guideline specialty-agent routing registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_registry",
    "routing_role",
    "routing_policy",
    "safety_boundary",
    "summary",
    "agents"
  ],
  "properties": {
    "schema_version": { "const": "kr_guideline_agent_registry.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_registry": { "$ref": "#/definitions/fileRef" },
    "routing_role": { "const": "retrieval_scope_registry_not_separate_medical_models" },
    "routing_policy": { "type": "object" },
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "needs_review",
        "medical_approval",
        "student_visible",
        "generation_eligible",
        "review_retrieval_enabled"
      ],
      "properties": {
        "needs_review": { "const": true },
        "medical_approval": { "const": false },
        "student_visible": { "const": false },
        "generation_eligible": { "const": false },
        "review_retrieval_enabled": { "const": true }
      }
    },
    "summary": { "type": "object" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "label_ko",
          "specialties",
          "intents",
          "clinical_axes",
          "source_ids",
          "source_count",
          "current_source_ids",
          "review_only_source_ids",
          "review_retrieval_enabled",
          "student_retrieval_enabled",
          "generation_retrieval_enabled"
        ],
        "properties": {
          "agent_id": { "type": "string", "pattern": "^kr-specialist:[a-z0-9._-]+$" },
          "label_ko": { "type": "string", "minLength": 1 },
          "specialties": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "intents": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "clinical_axes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "source_count": { "type": "integer", "minimum": 0 },
          "current_source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "review_only_source_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "review_retrieval_enabled": { "const": true },
          "student_retrieval_enabled": { "const": false },
          "generation_retrieval_enabled": { "const": false }
        }
      }
    }
  },
  "definitions": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
